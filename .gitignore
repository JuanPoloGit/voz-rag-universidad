# Indice vectorial y memoria dinamica (datos de visitantes: no versionar)
chroma_db/
hacu_memory.db
hacu_memory.db-wal
hacu_memory.db-shm
logs/
pruebas/informes/

# Carpeta que crea la app de escritorio de Claude al entregar archivos
Claude outputs/

# Variables de entorno y configuraciones locales
.env
.vscode/
