# Entornos virtuales y compilaciones
venv/
__pycache__/
*.pyc

# Modelos de IA locales (pesados)
models/*.gguf
models/*.bin
# Voces de Piper (~110 MB cada una): se bajan con `python -m hacu.voz --descargar`
models/voz/
