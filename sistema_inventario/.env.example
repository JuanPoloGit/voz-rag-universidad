# Inventario AudacIA — Variables de entorno
# Copiar a .env y ajustar los valores reales.
# NUNCA subir .env a Git.

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100

# PostgreSQL
DB_NAME=inventario_audacia
DB_USER=inventario
DB_PASSWORD=cambia_esta_contraseña
DB_HOST=localhost
DB_PORT=5432

# Seguridad de sesiones
SESSION_COOKIE_AGE_DAYS=7
LOGIN_LOCKOUT_MINUTES=15
LOGIN_MAX_ATTEMPTS=5

# Haku
HAKU_VOICE_CONTEXT_TIMEOUT_MINUTES=30
HAKU_TRANSCRIPTION_LOG_RETENTION_DAYS=30

# Zona horaria
TIME_ZONE=America/Bogota
