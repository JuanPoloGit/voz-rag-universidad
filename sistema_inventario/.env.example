# Inventario AudacIA — Variables de entorno
# Copiar a .env y ajustar los valores reales.
# NUNCA subir .env a Git.

# Django
# Para producción, genere una clave segura ejecutando: python scripts/generar_secret_key.py
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100

# Motor de base de datos: "sqlite" (desarrollo mono-PC) o "postgresql" (producción)
DB_ENGINE=sqlite
USE_SQLITE=True

# Backend de caché: "locmem" (por defecto, RAM mono-proceso) o "database" (PostgreSQL multi-proceso)
CACHE_BACKEND=locmem

# PostgreSQL (usado cuando DB_ENGINE=postgresql)
DB_NAME=inventario_audacia
DB_USER=inventario
DB_PASSWORD=cambia_esta_contraseña
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Seguridad de sesiones
SESSION_COOKIE_AGE_DAYS=7
LOGIN_LOCKOUT_MINUTES=15
LOGIN_MAX_ATTEMPTS=5

# Haku
HAKU_VOICE_CONTEXT_TIMEOUT_MINUTES=30
HAKU_TRANSCRIPTION_LOG_RETENTION_DAYS=30

# Zona horaria
TIME_ZONE=America/Bogota
